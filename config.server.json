{
  "mode": "server",
  "listen": ":8443",
  "path": "/tunnel",
  "transport": "h2",
  "network": "tcp",
  "token": "replace-with-a-strong-token",
  "tls": true,
  "cert": "",
  "key": "",
  "local_only": true,
  "session_window_kb": 256,
  "drain_timeout_sec": 30,
  "padding": {
    "min_record_bytes": 600,
    "max_record_bytes": 1200
  },
  "brutal": {
    "enabled": false,
    "rate_bytes": 0,
    "cwnd_gain": 15,
    "negotiate": true
  },
  "log_level": "info"
}
